#!/usr/bin/env bash
set -euo pipefail

venv=/home/pablob/.venvs/poker
toolkit=${venv}/lib/python3.10/site-packages/nvidia/cu13
python=${venv}/bin/python

if [[ ! -x "${python}" ]]; then
  echo "missing shared poker virtualenv interpreter: ${python}" >&2
  exit 2
fi
if [[ ! -x "${toolkit}/bin/nvcc" || ! -d "${toolkit}/lib" ]]; then
  echo "missing checked CUDA 13 toolkit in the shared poker virtualenv" >&2
  exit 2
fi

export CUDA_HOME="${toolkit}"
export PATH="${venv}/bin:${toolkit}/bin:${PATH}"
export LD_LIBRARY_PATH="${toolkit}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

"${python}" -c 'import torch; from poker_gpu_evaluator import pbg; assert str(torch.version.cuda).startswith("13."), torch.version.cuda; assert pbg.API_VERSION == "pbg-v3", pbg.API_VERSION'
exec "${python}" "$@"
